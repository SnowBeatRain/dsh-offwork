{
  "name": "dsh-offwork",
  "version": "1.2.3",
  "description": "Harness 页面角色与小卡片、下班倒计时、全天喝水提醒、独立抽烟计时和收入展示。A Harness companion with clock-out, all-day hydration and smoking timers, earnings and action previews.",
  "type": "module",
  "license": "MIT",
  "author": "now",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnowBeatRain/dsh-offwork.git"
  },
  "homepage": "https://github.com/SnowBeatRain/dsh-offwork#readme",
  "bugs": {
    "url": "https://github.com/SnowBeatRain/dsh-offwork/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-widget",
    "countdown",
    "salary",
    "offwork",
    "overlay"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "settings-api.js",
    "companion-state.js",
    "companion-image.js",
    "companion-app.js",
    "media-server.js",
    "media-manifest.js",
    "client.js",
    "client.source.js",
    "clock.js",
    "ui-utils.js",
    "companion.js",
    "pet-view.js",
    "pet-motion.js",
    "pet-video.js",
    "pet-reminder.js",
    "pet-interactions.js",
    "pet-surfaces.js",
    "hydration.js",
    "hydration-store.js",
    "countdown.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/characters/*",
    "assets/animations/*",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "docs/RELEASE-1.2.3.md",
    "tests/*.mjs",
    "tools/*.mjs"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "format": "prettier --write . && npm run build",
    "format:check": "prettier --check .",
    "test": "node tools/build.mjs --check && node --test tests/*.mjs",
    "check:package": "node tools/check-package.mjs",
    "check": "npm run format:check && npm test && npm run check:package",
    "prepublishOnly": "npm run build && npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.7",
    "prettier": "3.9.10"
  }
}
