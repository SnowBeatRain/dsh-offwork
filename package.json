{
  "name": "dsh-offwork",
  "version": "1.0.0",
  "description": "下班倒计时与实时工资悬浮窗：可拖动、可调透明度、工资可隐藏。A draggable countdown and salary overlay for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "now",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnowBeatRain/dsh-offwork.git"
  },
  "homepage": "https://github.com/SnowBeatRain/dsh-offwork#readme",
  "bugs": {
    "url": "https://github.com/SnowBeatRain/dsh-offwork/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-widget",
    "countdown",
    "salary",
    "offwork",
    "overlay"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.source.js",
    "clock.js",
    "ui-utils.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "tests/*.mjs",
    "tools/*.mjs"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "format": "prettier --write . && npm run build",
    "format:check": "prettier --check .",
    "test": "node tools/build.mjs --check && node --test tests/*.mjs",
    "check:package": "node tools/check-package.mjs",
    "check": "npm run format:check && npm test && npm run check:package",
    "prepublishOnly": "npm run build && npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
